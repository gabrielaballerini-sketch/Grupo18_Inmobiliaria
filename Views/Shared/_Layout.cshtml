@using System.Security.Claims;

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Inmobiliaria ABD</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Grupo18_Inmobiliaria.styles.css" asp-append-version="true" />

    <!-- Cargar Vue 3 CDN -->
    <script src="https://unpkg.com/vue@3/dist/vue.global.js"></script>

    <!-- Cargar Leaflet (CSS y JS) -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

</head>

<body>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <header>
            <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
                <div class="container-fluid">

                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">

                        <ul class="navbar-nav flex-grow-1">
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index"> <i
                                        class="bi bi-house-door me-1"></i>
                                    Home</a>
                            </li>
                            @if (User.Identity != null && User.Identity.IsAuthenticated)

                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-area="" asp-controller="Inquilino" asp-action="Index"><i
                                            class="bi bi-people me-1"></i>Inquilinos</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-area="" asp-controller="Propietario" asp-action="Index"><i
                                            class="bi bi-person me-1"></i>Propietario</a>
                                </li>
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle text-dark" href="#" id="navbarDropdownReservas"
                                        role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        <i class="bi bi-calendar-check me-1"></i>Reservas
                                    </a>
                                    <ul class="dropdown-menu" aria-labelledby="navbarDropdownReservas">
                                        <li>
                                            <a class="dropdown-item" asp-controller="Reserva" asp-action="Index">
                                                <i class="bi bi-list-ul me-1"></i> Listado de reservas
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-controller="Reserva" asp-action="Create">
                                                <i class="bi bi-plus-circle me-1"></i> Nueva Reserva
                                            </a>
                                        </li>

                                        <li>
                                            <a class="dropdown-item" asp-controller="Reserva" asp-action="Buscar">
                                                <i class="bi bi-search me-1"></i> Buscar Reservas
                                            </a>
                                        </li>
                                    </ul>
                                </li>
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle text-dark" href="#" id="navbarDropdownInmuebles"
                                        role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        <i class="bi bi-house-door me-1"></i>Inmueble</a>
                                    <ul class="dropdown-menu" aria-labelledby="navbarDropdownInmuebles">
                                          <li>
                                            <a class="dropdown-item" asp-controller="Inmueble" asp-action="Create">
                                                <i class="bi bi-plus-circle me-1"></i> Nuevo inmueble
                                            </a>
                                        </li>
                                        
                                        <li>
                                            <a class="dropdown-item" asp-controller="Inmueble" asp-action="Index">
                                                <i class="bi bi-list-ul me-1"></i> Listado General
                                            </a>
                                        </li>
                                          <li>
                                            <a class="dropdown-item" asp-controller="Reserva" asp-action="MasReservados">
                                                <i class="bi bi-bar-chart me-1"></i> Mas Reservados
                                            </a>
                                        </li>

                                        <li>
                                            <a class="dropdown-item" asp-controller="Inmueble" asp-action="MenosReservados">
                                                <i class="bi  bi-bar-chart me-1"></i> Menos Reservados
                                            </a>
                                        </li>

                                        <li>
                                            <a class="dropdown-item" asp-controller="Inmueble" asp-action="Disponibles">
                                                <i class="bi bi-calendar-check me-1"></i> Disponibles por Fecha
                                            </a>
                                        </li>
                                        <li>
                                            <hr class="dropdown-divider">
                                        </li>

                                    </ul>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-area="" asp-controller="TipoInmueble"
                                        asp-action="Index"><i class="bi bi-building me-1"></i>Tipo de Inmueble</a>
                                </li>
                            }

                            @if (User.IsInRole("Administrativo"))
                            {

                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-area="" asp-controller="Usuario" asp-action="Index"><i
                                            class="bi bi-person-badge me-1"></i>Usuario</a>
                                </li>
                            }
                            </ul>
                            @if (User.Identity != null && User.Identity.IsAuthenticated)
                             {
                                 <ul class="navbar-nav">

                                    <li class="nav-item dropdown">

                                        <a class="nav-link dropdown-toggle text-dark" href="#" id="usuarioDropdown" role="button"
                                            data-bs-toggle="dropdown" aria-expanded="false">

                                             <i class="bi bi-person-circle"></i>
                                            Hola, @User.Identity.Name

                                         </a>

                                        <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="usuarioDropdown">

              
                                            <li>
                                                <a class="dropdown-item" asp-controller="Usuario" asp-action="Perfil">

                                                    <i class="bi bi-person"></i>
                                                    Ver perfil

                                                </a>
                                             </li>

                                            <li>
                                                <hr class="dropdown-divider">
                                            </li>

              
                                            <li>
                                                <form asp-controller="Cuenta" asp-action="Logout" method="post">

                                                    @Html.AntiForgeryToken()

                                                    <button type="submit" class="dropdown-item">

                                                        <i class="bi bi-box-arrow-right"></i>
                                                         Cerrar sesión

                                                    </button>

                                                </form>
                                            </li>

                                        </ul>

                                    </li>

                                </ul>
                            }

                    </div>
                </div>
            </nav>
        </header>
    }
    <div class="container">
        <main role="main" class="pb-3">
            @if (TempData["Mensaje"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @TempData["Mensaje"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger">
                    @TempData["Error"]
                </div>
            }

            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - Grupo18_Inmobiliaria - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>