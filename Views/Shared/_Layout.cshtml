<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Grupo18_Inmobiliaria</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Grupo18_Inmobiliaria.styles.css" asp-append-version="true" />

    <!-- Cargar Vue 3 CDN -->
    <script src="https://unpkg.com/vue@3/dist/vue.global.js"></script>

    <!-- Cargar Leaflet (CSS y JS) -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>


</head>

<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">Grupo18_Inmobiliaria</a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                    aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">



                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Inquilino"
                                asp-action="Index">Inquilino</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Propietario"
                                asp-action="Index">Propietario</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Reserva"
                                asp-action="Index">Reserva</a>
                        </li>

                        <li class="nav-item dropdown">

                            <a class="nav-link dropdown-toggle text-dark" href="#" id="navbarDropdownInmuebles"
                                role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Inmueble
                            </a>
                            <ul class="dropdown-menu" aria-labelledby="navbarDropdownInmuebles">
                                <li>
                                    <a class="dropdown-item" asp-controller="Inmueble" asp-action="Index">
                                        <i class="bi bi-list-ul me-1"></i> Listado General
                                    </a>
                                </li>

                                <li>
                                    <a class="dropdown-item" asp-controller="Inmueble" asp-action="Index">
                                        <i class="bi bi-list-ul me-1"></i> Listado Por Propietario
                                    </a>
                                </li>

                                <li>
                                    <a class="dropdown-item" asp-controller="Inmueble" asp-action="Index">
                                        <i class="bi bi-list-ul me-1"></i> Mas Reservados
                                    </a>
                                </li>

                                <li>
                                    <a class="dropdown-item" asp-controller="Inmueble" asp-action="Index">
                                        <i class="bi bi-list-ul me-1"></i> Menos Reservados
                                    </a>
                                </li>

                                <li>
                                    <a class="dropdown-item" asp-controller="Inmueble" asp-action="Disponibles">
                                        <i class="bi bi-calendar-check me-1"></i> Disponibles por Fecha
                                    </a>
                                </li>
                                <li>
                                    <hr class="dropdown-divider">
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-controller="Inmueble" asp-action="Crear">
                                        <i class="bi bi-plus-circle me-1"></i> Nuevo Inmueble
                                    </a>
                                </li>
                            </ul>
                        </li>



                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Usuario"
                                asp-action="Index">Usuario</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="TipoInmueble"
                                asp-action="Index">Tipo de Inmueble</a>
                        </li>




                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @if (TempData["Mensaje"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @TempData["Mensaje"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger">
                    @TempData["Error"]
                </div>
            }

            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - Grupo18_Inmobiliaria - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>