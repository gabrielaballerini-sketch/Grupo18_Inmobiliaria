
@{
    ViewData["Title"] = "Inicio";
}

<div class="container py-5">

    <!-- Encabezado -->
    <div class="text-center mb-5">
        <i class="bi bi-buildings display-1 text-primary"></i>

        <h1 class="display-4 fw-bold mt-3">
            Proyecto Inmobiliaria ABD
        </h1>

        <p class="lead text-muted">
            Sistema integral para la gestión de propiedades,
            inquilinos, propietarios y reservas.
        </p>

        @if (User.Identity?.IsAuthenticated == true)
        {
            <p class="mt-3">
                <i class="bi bi-person-circle me-1"></i>
                Bienvenido, <strong>@User.Identity.Name</strong>
            </p>
        }
        else
        {
            <p class="mt-3 text-muted">
                Iniciá sesión para acceder a los módulos del sistema.
            </p>
        }
    </div>


    @if (User.Identity?.IsAuthenticated == true)
    {
        <!-- Accesos principales -->
        <div class="row g-4 justify-content-center">

            <div class="col-md-4 col-lg-3">
                <a asp-controller="Inmueble"
                   asp-action="Index"
                   class="text-decoration-none">

                    <div class="card h-100 shadow-sm text-center p-4">
                        <i class="bi bi-house-door display-4 text-primary"></i>

                        <h4 class="mt-3">
                            Inmuebles
                        </h4>

                        <p class="text-muted mb-0">
                            Gestioná las propiedades disponibles.
                        </p>
                    </div>

                </a>
            </div>


            <div class="col-md-4 col-lg-3">
                <a asp-controller="Inquilino"
                   asp-action="Index"
                   class="text-decoration-none">

                    <div class="card h-100 shadow-sm text-center p-4">
                        <i class="bi bi-people display-4 text-primary"></i>

                        <h4 class="mt-3">
                            Inquilinos
                        </h4>

                        <p class="text-muted mb-0">
                            Administrá la información de los inquilinos.
                        </p>
                    </div>

                </a>
            </div>


            <div class="col-md-4 col-lg-3">
                <a asp-controller="Propietario"
                   asp-action="Index"
                   class="text-decoration-none">

                    <div class="card h-100 shadow-sm text-center p-4">
                        <i class="bi bi-person display-4 text-primary"></i>

                        <h4 class="mt-3">
                            Propietarios
                        </h4>

                        <p class="text-muted mb-0">
                            Gestioná los propietarios de los inmuebles.
                        </p>
                    </div>

                </a>
            </div>


            <div class="col-md-4 col-lg-3">
                <a asp-controller="Reserva"
                   asp-action="Index"
                   class="text-decoration-none">

                    <div class="card h-100 shadow-sm text-center p-4">
                        <i class="bi bi-calendar-check display-4 text-primary"></i>

                        <h4 class="mt-3">
                            Reservas
                        </h4>

                        <p class="text-muted mb-0">
                            Consultá y administrá las reservas.
                        </p>
                    </div>

                </a>
            </div>


            @if (User.IsInRole("Administrativo"))
            {
                <div class="col-md-4 col-lg-3">
                    <a asp-controller="Usuario"
                       asp-action="Index"
                       class="text-decoration-none">

                        <div class="card h-100 shadow-sm text-center p-4">
                            <i class="bi bi-person-badge display-4 text-primary"></i>

                            <h4 class="mt-3">
                                Usuarios
                            </h4>

                            <p class="text-muted mb-0">
                                Administrá los usuarios del sistema.
                            </p>
                        </div>

                    </a>
                </div>


                <div class="col-md-4 col-lg-3">
                    <a asp-controller="TipoInmueble"
                       asp-action="Index"
                       class="text-decoration-none">

                        <div class="card h-100 shadow-sm text-center p-4">
                            <i class="bi bi-building display-4 text-primary"></i>

                            <h4 class="mt-3">
                                Tipos de Inmueble
                            </h4>

                            <p class="text-muted mb-0">
                                Gestioná los tipos de propiedades.
                            </p>
                        </div>

                    </a>
                </div>
            }

        </div>
    }
    else
    {
        <!-- Usuario no autenticado -->
        <div class="text-center mt-4">

            <a asp-controller="Cuenta"
               asp-action="Login"
               class="btn btn-primary btn-lg px-4">

                <i class="bi bi-box-arrow-in-right me-2"></i>
                Iniciar sesión

            </a>

        </div>
    }

</div>

