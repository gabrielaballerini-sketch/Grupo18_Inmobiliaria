@model Inquilino

@{
    ViewData["Title"] = "Dar de Baja Inquilino";
}

<div class="container mt-4">

    <div class="card shadow">

        <div class="card-header bg-danger text-white">
            <h3 class="mb-0">Dar de Baja Inquilino</h3>
        </div>

        <div class="card-body">

            <div class="alert alert-warning" role="alert">
                <strong>Atención:</strong>
                estás a punto de dar de baja este inquilino.
                El registro no será eliminado físicamente de la base de datos.
            </div>

            <h5 class="mb-3">Datos del inquilino</h5>

            <dl class="row">

                <dt class="col-sm-3">
                    ID
                </dt>
                <dd class="col-sm-9">
                    @Model.IdInquilino
                </dd>

                <dt class="col-sm-3">
                    Nombre completo
                </dt>
                <dd class="col-sm-9">
                    @Model.Nombre @Model.Apellido
                </dd>

                <dt class="col-sm-3">
                    DNI
                </dt>
                <dd class="col-sm-9">
                    @Model.Dni
                </dd>

                <dt class="col-sm-3">
                    Teléfono
                </dt>
                <dd class="col-sm-9">
                    @Model.Telefono
                </dd>

                <dt class="col-sm-3">
                    Email
                </dt>
                <dd class="col-sm-9">
                    @Model.Email
                </dd>

            </dl>

            <hr />

            <div class="d-flex gap-2">

                <form asp-action="Delete" method="post">

                    <input type="hidden" asp-for="IdInquilino" />

                    <button type="submit" class="btn btn-danger">
                        Confirmar Baja
                    </button>

                </form>

                <a asp-action="Index" class="btn btn-secondary">
                    Cancelar
                </a>

            </div>

        </div>
    </div>
</div>