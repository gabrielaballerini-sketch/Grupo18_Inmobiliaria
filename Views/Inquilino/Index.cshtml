@model List<Grupo18_Inmobiliaria.Models.Inquilino>

@{
    ViewData["Title"] = "Inquilinos";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1>Inquilinos</h1>

        <div>
            <a asp-action="Create" class="btn btn-primary">
                Nuevo Inquilino
            </a>

            <a asp-action="Inactivos" class="btn btn-secondary">
                Inquilinos dados de baja
            </a>
        </div>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            No hay inquilinos registrados.
        </div>
    }
    else
    {
        <div class="table-responsive">

            <table class="table table-striped table-hover align-middle">

                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>DNI</th>
                        <th>Nombre</th>
                        <th>Apellido</th>
                        <th>Teléfono</th>
                        <th>Email</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var inquilino in Model)
                    {
                        <tr>
                            <td>@inquilino.IdInquilino</td>
                            <td>@inquilino.Dni</td>
                            <td>@inquilino.Nombre</td>
                            <td>@inquilino.Apellido</td>
                            <td>@inquilino.Telefono</td>
                            <td>@inquilino.Email</td>

                            <td class="text-center">

                                <a asp-action="Edit" asp-route-id="@inquilino.IdInquilino" class="btn btn-warning btn-sm">
                                    Editar
                                </a>

                                <a asp-action="Delete" asp-route-id="@inquilino.IdInquilino" class="btn btn-danger btn-sm">
                                    Dar de baja
                                </a>

                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>

        <!-- PAGINACION CON NÚMEROS -->

        <div class="d-flex justify-content-center mt-4">

            <nav>

                <ul class="pagination">

                    @for (int i = 1; i <= ViewBag.TotalPaginas; i++)
                    {
                        <li class="page-item @(i == ViewBag.PaginaActual ? "active" : "")">

                            <a class="page-link" asp-action="Index" asp-route-pagina="@i" asp-route-tamPagina="10">

                                @i

                            </a>

                        </li>
                    }

                </ul>

            </nav>

        </div>

    }

</div>