@model Grupo18_Inmobiliaria.Models.Pago

@{
    var reserva = ViewBag.Reserva as Grupo18_Inmobiliaria.Models.Reserva;
    ViewData["Title"] = $"Registrar Pago - Reserva #{reserva?.IdReserva}";
}

<h2>Registrar Pago para Reserva #@reserva?.IdReserva</h2>
<hr />

<div class="row">
    <div class="col-md-6">
        <form asp-action="Crear" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="IdReserva" />

            <div class="mb-3">
                <label asp-for="Importe" class="form-label">Importe ($)</label>
                <input asp-for="Importe" class="form-control" type="number" step="0.01" />
                <span asp-validation-for="Importe" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="FechaPago" class="form-label">Fecha de Pago</label>
                <input asp-for="FechaPago" class="form-control" type="datetime-local" value="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" />
                <span asp-validation-for="FechaPago" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ConceptoPago" class="form-label">Concepto de Pago</label>
                <select asp-for="ConceptoPago" class="form-select" asp-items="Html.GetEnumSelectList<Grupo18_Inmobiliaria.Models.ConceptoPago>()">
                </select>
                <span asp-validation-for="ConceptoPago" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="MedioPago" class="form-label">Medio de Pago</label>
                <select asp-for="MedioPago" class="form-select" asp-items="Html.GetEnumSelectList<Grupo18_Inmobiliaria.Models.MedioPago>()">
                </select>
                <span asp-validation-for="MedioPago" class="text-danger"></span>
            </div>

            <div class="mt-4">
                <button type="submit" class="btn btn-primary">Guardar Pago</button>
                <a asp-action="PorReserva" asp-route-id="@Model.IdReserva" class="btn btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}