@model Grupo18_Inmobiliaria.Models.Reserva

@{
    ViewData["Title"] = "Editar Reserva";
}

<div class="container mt-4">

    <h1>Editar Reserva</h1>

    <hr />

    <form asp-action="Edit"
          asp-route-id="@Model.IdReserva"
          method="post">

        @Html.AntiForgeryToken()

        <input type="hidden"
               asp-for="IdReserva" />


        <div asp-validation-summary="ModelOnly"
             class="text-danger mb-3">
        </div>


        <!-- INQUILINO -->

        <div class="mb-3">

            <label asp-for="IdInquilino" class="form-label">
                Inquilino
            </label>

            <select asp-for="IdInquilino"
                    asp-items="ViewBag.Inquilinos"
                    class="form-select">

                <option value="0">
                    -- Seleccione un inquilino --
                </option>

            </select>

            <span asp-validation-for="IdInquilino"
                  class="text-danger">
            </span>

        </div>


        <!-- INMUEBLE -->

        <div class="mb-3">

            <label asp-for="IdInmueble" class="form-label">
                Inmueble
            </label>

            <select asp-for="IdInmueble"
                    asp-items="ViewBag.Inmuebles"
                    class="form-select">

                <option value="0">
                    -- Seleccione un inmueble --
                </option>

            </select>

            <span asp-validation-for="IdInmueble"
                  class="text-danger">
            </span>

        </div>


        <!-- MONTO DIARIO -->

        <div class="mb-3">

            <label asp-for="MontoDiario" class="form-label">
                Monto diario
            </label>

            <input asp-for="MontoDiario"
                   type="number"
                   step="0.01"
                   min="0"
                   class="form-control" />

            <span asp-validation-for="MontoDiario"
                  class="text-danger">
            </span>

        </div>


        <!-- FECHA INICIO -->

        <div class="mb-3">

            <label asp-for="FechaInicio" class="form-label">
                Fecha de inicio
            </label>

            <input asp-for="FechaInicio"
                   type="datetime-local"
                   class="form-control" />

            <span asp-validation-for="FechaInicio"
                  class="text-danger">
            </span>

        </div>


        <!-- FECHA FIN -->

        <div class="mb-3">

            <label asp-for="FechaFin" class="form-label">
                Fecha de finalización
            </label>

            <input asp-for="FechaFin"
                   type="datetime-local"
                   class="form-control" />

            <span asp-validation-for="FechaFin"
                  class="text-danger">
            </span>

        </div>


        <!-- BOTONES -->

        <div class="mt-4">

            <button type="submit"
                    class="btn btn-warning">
                Guardar Cambios
            </button>

            <a asp-action="Index"
               class="btn btn-secondary">
                Volver
            </a>

        </div>

    </form>

</div>


@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}