@model Grupo18_Inmobiliaria.Models.Reserva

@{
    ViewData["Title"] = "Finalizar Reserva Anticipadamente";

    string fechaMinima = Model.FechaInicio.Date
    .AddDays(1)
    .ToString("yyyy-MM-dd");

    string fechaMaxima = Model.FechaFin.Date
    .AddDays(-1)
    .ToString("yyyy-MM-dd");
}

<div class="container mt-4">

    <h1>
        <i class="bi bi-calendar-x"></i>
        Finalizar reserva anticipadamente
    </h1>

    <hr />

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <div class="alert alert-warning">
        <strong>Atención:</strong>
        Está por finalizar esta reserva antes de su fecha de finalización original.
        La fecha de finalización original se conservará para mantener el historial.
    </div>

    <div class="card shadow-sm mb-4">

        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">
                <i class="bi bi-calendar-check"></i>
                Datos de la reserva
            </h5>
        </div>

        <div class="card-body">

            <dl class="row mb-0">

                <dt class="col-sm-4">N° de reserva</dt>
                <dd class="col-sm-8">@Model.IdReserva</dd>

                <dt class="col-sm-4">Inquilino</dt>
                <dd class="col-sm-8">
                    @(Model.Inquilino != null
                                        ? $"{Model.Inquilino.Nombre} {Model.Inquilino.Apellido}"
                                        : "-")
                </dd>

                <dt class="col-sm-4">Inmueble</dt>
                <dd class="col-sm-8">
                    @(Model.Inmueble != null
                                        ? Model.Inmueble.Direccion
                                        : "-")
                </dd>

                <dt class="col-sm-4">Fecha de inicio</dt>
                <dd class="col-sm-8">
                    @Model.FechaInicio.ToString("dd/MM/yyyy HH:mm")
                </dd>

                <dt class="col-sm-4">Fecha de finalización original</dt>
                <dd class="col-sm-8 fw-bold">
                    @Model.FechaFin.ToString("dd/MM/yyyy HH:mm")
                </dd>

                <dt class="col-sm-4">Monto diario</dt>
                <dd class="col-sm-8">
                    $@Model.MontoDiario.ToString("N2")
                </dd>

            </dl>

        </div>
    </div>


    <div class="card shadow-sm">

        <div class="card-header bg-warning">
            <h5 class="mb-0">
                Finalización anticipada
            </h5>
        </div>

        <div class="card-body">

            <form asp-action="Finalizar" method="post">

                @Html.AntiForgeryToken()

                <input type="hidden" name="id" value="@Model.IdReserva" />

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3">
                </div>


                <!-- FECHA -->
                <div class="mb-4">

                    <label for="fechaFinalizacion" class="form-label fw-bold">

                        Fecha efectiva de finalización

                    </label>

                    <input type="date" id="fechaFinalizacion" name="fechaFinalizacion" class="form-control"
                        min="@fechaMinima" max="@fechaMaxima" required />

                    <div class="form-text">
                        La fecha debe ser posterior al inicio y anterior
                        a la fecha de finalización original.
                    </div>

                </div>


                <!-- MULTA -->
                <div class="alert alert-danger">

                    <h5>
                        <i class="bi bi-exclamation-triangle"></i>
                        Penalización
                    </h5>

                    <p>
                        Si transcurrió menos de la mitad del período,
                        corresponde el 50% del alquiler restante.
                    </p>

                    <p>
                        Si transcurrió la mitad o más,
                        corresponde el 25% del alquiler restante.
                    </p>

                    <hr />

                    <strong>
                        Multa calculada:
                    </strong>

                    <span id="montoMulta" class="fs-4 fw-bold">
                        $0,00
                    </span>

                </div>


                <!-- PAGO -->
                <div id="contenedorPago" class="border rounded p-3 bg-light mb-4">

                    <h5 class="text-primary">
                        <i class="bi bi-cash-coin"></i>
                        Pago de la multa
                    </h5>

                    <div class="form-check mb-3">

                        <input class="form-check-input" type="checkbox" id="pagaMultaNow" name="pagaMultaNow"
                            value="true" required />

                        <label class="form-check-label fw-bold" for="pagaMultaNow">

                            El inquilino abona la multa en este momento.

                        </label>

                    </div>


                    <div class="mb-3">

                        <label for="medioPago" class="form-label fw-bold">

                            Medio de pago

                        </label>

                        <select id="medioPago" name="medioPago" class="form-select" required>

                            <option value="1">Efectivo</option>
                            <option value="2">Débito</option>
                            <option value="3">Crédito</option>
                            <option value="4">Transferencia</option>

                        </select>

                    </div>

                </div>


                <button type="submit" class="btn btn-danger">

                    <i class="bi bi-check-circle"></i>
                    Confirmar finalización

                </button>

                <a asp-action="Details" asp-route-id="@Model.IdReserva" class="btn btn-secondary">

                    <i class="bi bi-arrow-left"></i>
                    Cancelar

                </a>

            </form>

        </div>
    </div>

</div>


@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>

        const fechaInicio =
            new Date("@Model.FechaInicio.ToString("yyyy-MM-dd")");

        const fechaFinOriginal =
            new Date("@Model.FechaFin.ToString("yyyy-MM-dd")");

        const montoDiario =
            @Model.MontoDiario.ToString(
            System.Globalization.CultureInfo.InvariantCulture
                );

    const inputFecha =
        document.getElementById("fechaFinalizacion");

    const elementoMulta =
        document.getElementById("montoMulta");


    function calcularMulta() {

        if (!inputFecha.value) {
            elementoMulta.textContent = "$0,00";
            return;
        }

        const fechaFinalizacion =
            new Date(inputFecha.value);


        const duracionTotal =
            (fechaFinOriginal - fechaInicio)
            / (1000 * 60 * 60 * 24);


        const diasTranscurridos =
            (fechaFinalizacion - fechaInicio)
            / (1000 * 60 * 60 * 24);


        const diasRestantes =
            (fechaFinOriginal - fechaFinalizacion)
            / (1000 * 60 * 60 * 24);


        if (diasRestantes <= 0) {

            elementoMulta.textContent = "$0,00";
            return;

        }


        const alquilerRestante =
            diasRestantes * montoDiario;


        let multa;


        if (diasTranscurridos < duracionTotal / 2) {

            multa = alquilerRestante * 0.50;

        } else {

            multa = alquilerRestante * 0.25;

        }


        elementoMulta.textContent =
            multa.toLocaleString("es-AR", {
                style: "currency",
                currency: "ARS"
            });
    }


    inputFecha.addEventListener(
        "change",
        calcularMulta
    );

</script>
}