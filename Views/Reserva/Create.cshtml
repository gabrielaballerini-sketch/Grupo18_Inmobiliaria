@model Grupo18_Inmobiliaria.Models.Reserva

@{
    ViewData["Title"] = "Nueva Reserva";

    // Genera el formato YYYY-MM-THH:mm requerido por <input type="datetime-local">
    string fechaMinima = DateTime.Now.ToString("yyyy-MM-ddTHH:mm");
}

<div class="container mt-4">

    <h1>Nueva Reserva</h1>

    <hr />

    <form asp-action="Create" method="post">

        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly"
             class="text-danger mb-3">
        </div>


        <!-- INQUILINO -->

        <!-- INQUILINO CON BÚSQUEDA DINÁMICA -->
        <div class="mb-3 position-relative">
            <label class="form-label">Inquilino</label>

            <!-- Campo oculto que guarda el ID real para el envío del formulario -->
            <input type="hidden" asp-for="IdInquilino" id="IdInquilinoHidden" />

            <!-- Input donde el usuario escribe -->
            <input type="text" 
                   id="buscadorInquilino" 
                   class="form-control" 
                   placeholder="Escriba el nombre, apellido o DNI..." 
                   autocomplete="off" 
                   value="@(Model?.Inquilino != null ? $"{Model.Inquilino.Nombre} {Model.Inquilino.Apellido}" : "")" />

            <!-- Lista desplegable flotante para las sugerencias -->
            <ul id="listaSugerencias" class="dropdown-menu w-100 shadow-sm" style="max-height: 200px; overflow-y: auto; display: none;">
            </ul>

            <span asp-validation-for="IdInquilino" class="text-danger"></span>
        </div>


        <!-- INMUEBLE -->
<!-- INMUEBLE CON BÚSQUEDA DINÁMICA -->
<div class="mb-3 position-relative">
    <label class="form-label">Inmueble</label>

    <!-- Campo oculto que guarda el ID real del inmueble -->
    <input type="hidden" asp-for="IdInmueble" id="IdInmuebleHidden" />

    <!-- Input donde el usuario escribe la dirección -->
    <input type="text" 
           id="buscadorInmueble" 
           class="form-control" 
           placeholder="Escriba la dirección del inmueble..." 
           autocomplete="off" 
           value="@(Model?.Inmueble != null ? Model.Inmueble.Direccion : "")" />

    <!-- Lista desplegable flotante para las sugerencias de inmuebles -->
    <ul id="listaSugerenciasInmueble" class="dropdown-menu w-100 shadow-sm" style="max-height: 200px; overflow-y: auto; display: none;">
    </ul>

    <span asp-validation-for="IdInmueble" class="text-danger"></span>
</div>


       <!-- MONTO DIARIO -->
        <div class="mb-3">
            <label asp-for="MontoDiario" class="form-label">Monto Diario</label>
            <input asp-for="MontoDiario" id="inputMonto" type="number" step="any" min="0" class="form-control" readonly />
            <span asp-validation-for="MontoDiario" class="text-danger"></span>
        </div>


        <!-- FECHA INICIO -->

        <div class="mb-3">

            <label asp-for="FechaInicio" class="form-label">
                Fecha de inicio
            </label>

            <input asp-for="FechaInicio"
                   id="FechaInicio"
                   type="datetime-local"
                   min="@fechaMinima"
                   class="form-control" />

            <span asp-validation-for="FechaInicio"
                  class="text-danger">
            </span>

        </div>


        <!-- FECHA FIN -->

        <div class="mb-3">

            <label asp-for="FechaFin" class="form-label">
                Fecha de finalización
            </label>

            <input asp-for="FechaFin"
                   id="FechaFin"
                   type="datetime-local"
                   min="@fechaMinima"
                   class="form-control" />

            <span asp-validation-for="FechaFin"
                  class="text-danger">
            </span>

        </div>


        <!-- BOTONES -->

        <div class="mt-4">

            <button type="submit"
                    class="btn btn-primary">
                Guardar Reserva
            </button>

            <a asp-action="Index"
               class="btn btn-secondary">
                Volver
            </a>

        </div>

    </form>

</div>

<script>
    // 1. BÚSQUEDA DINÁMICA DE INQUILINOS
    const inputBuscadorInquilino = document.getElementById("buscadorInquilino");
    const inputHiddenInquilino = document.getElementById("IdInquilinoHidden");
    const listaSugerenciasInquilino = document.getElementById("listaSugerencias");
    let timeoutInquilino;

    inputBuscadorInquilino.addEventListener("input", function () {
        clearTimeout(timeoutInquilino);
        let term = this.value.trim();

        if (term.length < 2) {
            listaSugerenciasInquilino.style.display = "none";
            return;
        }

        timeoutInquilino = setTimeout(() => {
            fetch(`/Reserva/BuscarInquilinosPorNombre?term=${encodeURIComponent(term)}`)
                .then(response => response.json())
                .then(data => {
                    listaSugerenciasInquilino.innerHTML = "";

                    if (data.length === 0) {
                        listaSugerenciasInquilino.innerHTML = `<li class="dropdown-item text-muted">No se encontraron inquilinos</li>`;
                    } else {
                        data.forEach(item => {
                            let li = document.createElement("li");
                            li.innerHTML = `<a class="dropdown-item" href="#" data-id="${item.id}">${item.nombreCompleto}</a>`;
                            
                            li.querySelector("a").addEventListener("click", function (e) {
                                e.preventDefault();
                                inputHiddenInquilino.value = item.id;
                                inputBuscadorInquilino.value = item.nombreCompleto;
                                listaSugerenciasInquilino.style.display = "none";
                            });

                            listaSugerenciasInquilino.appendChild(li);
                        });
                    }
                    listaSugerenciasInquilino.style.display = "block";
                })
                .catch(err => console.error("Error:", err));
        }, 300);
    });


    // 2. BÚSQUEDA DINÁMICA DE INMUEBLES
    const inputBuscadorInmueble = document.getElementById("buscadorInmueble");
    const inputHiddenInmueble = document.getElementById("IdInmuebleHidden");
    const listaSugerenciasInmueble = document.getElementById("listaSugerenciasInmueble");
    const inputMonto = document.getElementById("inputMonto");
    let timeoutInmueble;

    inputBuscadorInmueble.addEventListener("input", function () {
        clearTimeout(timeoutInmueble);
        let term = this.value.trim();

        if (term.length < 2) {
            listaSugerenciasInmueble.style.display = "none";
            inputMonto.value = ""; // Limpia el monto si borra el texto
            return;
        }

        timeoutInmueble = setTimeout(() => {
            fetch(`/Reserva/BuscarInmueblesPorDireccion?term=${encodeURIComponent(term)}`)
                .then(response => response.json())
                .then(data => {
                    listaSugerenciasInmueble.innerHTML = "";

                    if (data.length === 0) {
                        listaSugerenciasInmueble.innerHTML = `<li class="dropdown-item text-muted">No se encontraron inmuebles</li>`;
                        inputMonto.value = "";
                    } else {
                        data.forEach(item => {
                            let li = document.createElement("li");
                            li.innerHTML = `<a class="dropdown-item" href="#" data-id="${item.id}" data-precio="${item.precio}">${item.direccion}</a>`;
                            
                            li.querySelector("a").addEventListener("click", function (e) {
                                e.preventDefault();
                                inputHiddenInmueble.value = item.id;
                                inputBuscadorInmueble.value = item.direccion;
                                inputMonto.value = item.precio; // Carga automáticamente el precio del inmueble seleccionado
                                listaSugerenciasInmueble.style.display = "none";
                            });

                            listaSugerenciasInmueble.appendChild(li);
                        });
                    }
                    listaSugerenciasInmueble.style.display = "block";
                })
                .catch(err => console.error("Error:", err));
        }, 300);
    });


    // CERRAR LISTAS AL HACER CLIC AFUERA
    document.addEventListener("click", function (e) {
        if (!inputBuscadorInquilino.contains(e.target) && !listaSugerenciasInquilino.contains(e.target)) {
            listaSugerenciasInquilino.style.display = "none";
        }
        if (!inputBuscadorInmueble.contains(e.target) && !listaSugerenciasInmueble.contains(e.target)) {
            listaSugerenciasInmueble.style.display = "none";
        }
    });


    // 3. CONTROL DE FECHAS
    const inputInicio = document.getElementById("FechaInicio");
    const inputFin = document.getElementById("FechaFin");

    inputInicio.addEventListener("change", function () {
        if (this.value) {
            inputFin.min = this.value;
            if (inputFin.value && inputFin.value < this.value) {
                inputFin.value = this.value;
            }
        }
    });
</script>