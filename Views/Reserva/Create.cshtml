@model Grupo18_Inmobiliaria.Models.Reserva

@{
    ViewData["Title"] = "Nueva Reserva";

    // Genera el formato YYYY-MM-THH:mm requerido por <input type="datetime-local">
    string fechaMinima = DateTime.Now.ToString("yyyy-MM-ddTHH:mm");
}

<div class="container mt-4">

    <h1>Nueva Reserva</h1>

    <hr />

    <form asp-action="Create" method="post">

        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly"
             class="text-danger mb-3">
        </div>


        <!-- INQUILINO -->

        <div class="mb-3">

            <label asp-for="IdInquilino" class="form-label">
                Inquilino
            </label>

            <select asp-for="IdInquilino"
                    asp-items="ViewBag.Inquilinos"
                    class="form-select">

                <option value="0">
                    -- Seleccione un inquilino --
                </option>

            </select>

            <span asp-validation-for="IdInquilino"
                  class="text-danger">
            </span>

        </div>


        <!-- INMUEBLE -->

        <div class="mb-3">

            <label asp-for="IdInmueble" class="form-label">
                Inmueble
            </label>

            <select asp-for="IdInmueble"
                    asp-items="ViewBag.Inmuebles"
                    class="form-select">

                <option value="0">
                    -- Seleccione un inmueble --
                </option>

            </select>

            <span asp-validation-for="IdInmueble"
                  class="text-danger">
            </span>

        </div>


       <!-- MONTO DIARIO -->
        <div class="mb-3">
            <label asp-for="MontoDiario" class="form-label">Monto Diario</label>
            <input asp-for="MontoDiario" id="inputMonto" type="number" step="any" min="0" class="form-control" readonly />
            <span asp-validation-for="MontoDiario" class="text-danger"></span>
        </div>


        <!-- FECHA INICIO -->

        <div class="mb-3">

            <label asp-for="FechaInicio" class="form-label">
                Fecha de inicio
            </label>

            <input asp-for="FechaInicio"
                   id="FechaInicio"
                   type="datetime-local"
                   min="@fechaMinima"
                   class="form-control" />

            <span asp-validation-for="FechaInicio"
                  class="text-danger">
            </span>

        </div>


        <!-- FECHA FIN -->

        <div class="mb-3">

            <label asp-for="FechaFin" class="form-label">
                Fecha de finalización
            </label>

            <input asp-for="FechaFin"
                   id="FechaFin"
                   type="datetime-local"
                   min="@fechaMinima"
                   class="form-control" />

            <span asp-validation-for="FechaFin"
                  class="text-danger">
            </span>

        </div>


        <!-- BOTONES -->

        <div class="mt-4">

            <button type="submit"
                    class="btn btn-primary">
                Guardar Reserva
            </button>

            <a asp-action="Index"
               class="btn btn-secondary">
                Volver
            </a>

        </div>

    </form>

</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }

    <script>
        document.getElementById("IdInmueble").addEventListener("change", function () {
            let idInmueble = this.value;
            if (idInmueble && idInmueble !== "0") {
                fetch(`/Reserva/ObtenerPrecioInmueble/${idInmueble}`)
                    .then(response => response.json())
                    .then(data => {
                        document.getElementById("inputMonto").value = data.precio;
                    })
                    .catch(err => console.error(err));
            } else {
                document.getElementById("inputMonto").value = "";
            }
        });

        // Actualizar el valor 'min' de FechaFin según la FechaInicio elegida
        const inputInicio = document.getElementById("FechaInicio");
        const inputFin = document.getElementById("FechaFin");

        inputInicio.addEventListener("change", function () {
            if (this.value) {
                inputFin.min = this.value;
                if (inputFin.value && inputFin.value < this.value) {
                    inputFin.value = this.value;
                }
            }
        });
    </script>
}