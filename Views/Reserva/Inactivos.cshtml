@model IList<Grupo18_Inmobiliaria.Models.Reserva>

@{
    ViewData["Title"] = "Reservas dadas de baja";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">

        <h1>Reservas dadas de baja</h1>

        <a asp-action="Index" class="btn btn-secondary">
            Volver a reservas activas
        </a>

    </div>

  

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            No hay reservas dadas de baja.
        </div>
    }
    else
    {
        <table class="table table-striped table-bordered">

            <thead class="table-dark">
                <tr>
                    <th>Id</th>
                    <th>Monto diario</th>
                    <th>Fecha inicio</th>
                    <th>Fecha fin</th>
                    <th>Id Inquilino</th>
                    <th>Id Inmueble</th>
                    <th>Acciones</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var reserva in Model)
                {
                    <tr>

                        <td>
                            @reserva.IdReserva
                        </td>

                        <td>
                            $@reserva.MontoDiario
                        </td>

                        <td>
                            @reserva.FechaInicio.ToString("dd/MM/yyyy")
                        </td>

                        <td>
                            @reserva.FechaFin.ToString("dd/MM/yyyy")
                        </td>

                        <td>
                            @reserva.IdInquilino
                        </td>

                        <td>
                            @reserva.IdInmueble
                        </td>

                        <td>

                            <form asp-action="Reactivar"
                                  method="post"
                                  style="display:inline;">

                                @Html.AntiForgeryToken()

                                <input type="hidden"
                                       name="id"
                                       value="@reserva.IdReserva" />

                                <button type="submit"
                                        class="btn btn-success btn-sm">
                                    Reactivar
                                </button>

                            </form>

                        </td>

                    </tr>
                }

            </tbody>

        </table>

        <div class="d-flex justify-content-center mt-4">

            <nav>

                <ul class="pagination">

                    @for (int i = 1; i <= ViewBag.TotalPaginas; i++)
                    {
                        <li class="page-item @(i == ViewBag.PaginaActual ? "active" : "")">

                            <a class="page-link"
                               asp-action="Inactivos"
                               asp-route-pagina="@i"
                               asp-route-tamPagina="10">
                                @i
                            </a>

                        </li>
                    }

                </ul>

            </nav>

        </div>
    }

</div>