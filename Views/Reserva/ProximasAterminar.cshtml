@model IEnumerable<Grupo18_Inmobiliaria.Models.Reserva>

@{
    ViewData["Title"] = "Reservas Próximas a Terminar";
    int diasActuales = ViewBag.DiasSeleccionados ?? 7;
}

<div class="container mt-4">
    <h2 class="mb-3">
        <i class="bi bi-calendar-event"></i> Reservas que terminan en los próximos @diasActuales días
    </h2>

    <!-- PANEL DE FILTRADO -->
    <div class="card bg-light mb-4 shadow-sm">
        <div class="card-body">
            <form method="get" asp-controller="Reserva" asp-action="ProximasATerminar" class="row align-items-center g-3">
                <div class="col-md-5">
                    <label for="dias" class="form-label fw-bold">Especificar plazo en días:</label>
                    <div class="input-group">
                        <input type="number" 
                               id="dias" 
                               name="dias" 
                               class="form-control" 
                               min="1" 
                               max="365" 
                               value="@diasActuales" 
                               required />
                        <span class="input-group-text">días</span>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-funnel"></i> Filtrar
                        </button>
                    </div>
                </div>

                <!-- Botones de acceso rápido -->
                <div class="col-md-7">
                    <label class="form-label d-block text-muted fw-bold">Accesos rápidos:</label>
                    <div class="btn-group" role="group">
                        <a asp-controller="Reserva" asp-action="ProximasATerminar" asp-route-dias="7" class="btn btn-outline-secondary btn-sm @(diasActuales == 7 ? "active" : "")">7 días</a>
                        <a asp-controller="Reserva" asp-action="ProximasATerminar" asp-route-dias="15" class="btn btn-outline-secondary btn-sm @(diasActuales == 15 ? "active" : "")">15 días</a>
                        <a asp-controller="Reserva" asp-action="ProximasATerminar" asp-route-dias="20" class="btn btn-outline-secondary btn-sm @(diasActuales == 20 ? "active" : "")">20 días</a>
                        <a asp-controller="Reserva" asp-action="ProximasATerminar" asp-route-dias="30" class="btn btn-outline-secondary btn-sm @(diasActuales == 30 ? "active" : "")">30 días</a>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- TABLA DE RESULTADOS -->
    <div class="card shadow-sm">
        <div class="card-body p-0">
            <table class="table table-striped table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th># ID</th>
                        <th>Inmueble / Dirección</th>
                        <th>Inquilino</th>
                        <th>Fecha Inicio</th>
                        <th>Fecha Fin (Vencimiento)</th>
                        <th>Monto Diario</th>
                        <th>Estado</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-4">
                                <i class="bi bi-info-circle fs-4 d-block mb-2"></i>
                                No se encontraron reservas que finalicen dentro de los próximos <strong>@diasActuales</strong> días.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.IdReserva</td>
                                <td>
                                    <strong>@item.Inmueble?.Direccion</strong>
                                </td>
                                <td>@item.Inquilino?.Nombre @item.Inquilino?.Apellido</td>
                                <td>@item.FechaInicio.ToString("dd/MM/yyyy")</td>
                                <td>
                                    <span class="badge bg-warning text-dark fs-6">
                                        @item.FechaFin.ToString("dd/MM/yyyy")
                                    </span>
                                </td>
                                <td>$@item.MontoDiario.ToString("N2")</td>
                                <td>
                                    @if (item.Estado)
                                    {
                                        <span class="badge bg-success">Activa</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Inactiva</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>