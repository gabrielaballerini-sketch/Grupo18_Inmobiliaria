@model Grupo18_Inmobiliaria.Models.Reserva

@{
    ViewData["Title"] = $"Detalle de Reserva Dada de Baja #{Model.IdReserva}";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Detalle de Reserva <span class="text-danger">#@Model.IdReserva</span></h2>
            <span class="badge bg-danger fs-6">Reserva Dada de Baja</span>
        </div>
        <div>
            <a asp-action="Inactivos" class="btn btn-secondary">← Volver a la Lista de Bajas</a>
        </div>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="row">
        <!-- Columna Izquierda: Datos de la Reserva y Pagos -->
        <div class="col-md-7">
            <!-- Datos de la Reserva -->
            <div class="card shadow-sm mb-4 border-danger">
                <div class="card-header bg-danger text-white">
                    <i class="fas fa-calendar-times"></i> Datos de la Reserva Cancelada
                </div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-4">Fecha Inicio</dt>
                        <dd class="col-sm-8">@Model.FechaInicio.ToString("yyyy-MM-dd HH:mm")</dd>

                        <dt class="col-sm-4">Fecha Fin Original</dt>
                        <dd class="col-sm-8">@Model.FechaFin.ToString("yyyy-MM-dd HH:mm")</dd>

                        <dt class="col-sm-4">Monto Diario</dt>
                        <dd class="col-sm-8">$@Model.MontoDiario.ToString("N2")</dd>

                        <dt class="col-sm-4">Estado</dt>
                        <dd class="col-sm-8">
                            <span class="badge bg-danger">Inactiva / Cancelada</span>
                        </dd>
                    </dl>
                </div>
            </div>

            <!-- Pagos Registrados -->
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-success text-white">
                    <i class="fas fa-money-bill-wave"></i> Pagos Registrados
                </div>
                <div class="card-body">
                    @if (Model.PagosEfectuados != null && Model.PagosEfectuados.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-striped table-hover align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th>Fecha</th>
                                        <th>Concepto</th>
                                        <th>Medio</th>
                                        <th>Importe</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var pago in Model.PagosEfectuados)
                                    {
                                        <tr>
                                            <td>@pago.FechaPago.ToString("yyyy-MM-dd HH:mm")</td>
                                            <td>
                                                <span class="badge bg-secondary">@pago.ConceptoPago</span>
                                            </td>
                                            <td>@pago.MedioPago</td>
                                            <td class="fw-bold text-success">$@pago.Importe.ToString("N2")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-warning mb-0">
                            <i class="fas fa-exclamation-triangle"></i> No se registran pagos asociados a esta baja.
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Columna Derecha: Inquilino e Inmueble -->
        <div class="col-md-5">
            <!-- Tarjeta Inquilino -->
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-info text-white">
                    <i class="fas fa-user"></i> Inquilino
                </div>
                <div class="card-body">
                    @if (Model.Inquilino != null)
                    {
                        <p class="mb-2"><strong>Nombre:</strong> @Model.Inquilino.Nombre @Model.Inquilino.Apellido</p>
                        <p class="mb-2"><strong>DNI:</strong> @Model.Inquilino.Dni</p>
                        <p class="mb-2"><strong>Teléfono:</strong> @Model.Inquilino.Telefono</p>
                        <p class="mb-0"><strong>Email:</strong> @Model.Inquilino.Email</p>
                    }
                    else
                    {
                        <p class="text-muted mb-0">Sin datos de inquilino.</p>
                    }
                </div>
            </div>

            <!-- Tarjeta Inmueble -->
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-dark text-white">
                    <i class="fas fa-home"></i> Inmueble
                </div>
                <div class="card-body">
                    @if (Model.Inmueble != null)
                    {
                        <p class="mb-2"><strong>Dirección:</strong> @Model.Inmueble.Direccion</p>
                        <p class="mb-2"><strong>Capacidad:</strong> @Model.Inmueble.Capacidad personas</p>
                        <p class="mb-0"><strong>Precio Base:</strong> $@Model.Inmueble.PrecioAlquiler.ToString("N2")</p>
                    }
                    else
                    {
                        <p class="text-muted mb-0">Sin datos de inmueble.</p>
                    }
                </div>
            </div>
        </div>
    </div>
</div>