@model Grupo18_Inmobiliaria.Models.Reserva

@{
    ViewData["Title"] = "Dar de baja Reserva";
}

<div class="container mt-4">

    <h1>Dar de baja Reserva</h1>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <div class="alert alert-warning">
        <strong>¿Está seguro de que desea dar de baja esta reserva?</strong>
        <br />
        Esta acción realizará una baja administrativa de la reserva.
        La reserva no será eliminada físicamente del sistema.
    </div>


    <!-- DATOS DE LA RESERVA -->

    <div class="card p-4 mb-4 shadow-sm">

        <h4>Datos de la Reserva</h4>

        <dl class="row mt-3">

            <dt class="col-sm-3">
                N° de Reserva
            </dt>

            <dd class="col-sm-9">
                @Model.IdReserva
            </dd>


            <dt class="col-sm-3">
                Inquilino
            </dt>

            <dd class="col-sm-9">
                @(Model.Inquilino != null
                                ? $"{Model.Inquilino.Nombre} {Model.Inquilino.Apellido}"
                                : "-")
            </dd>


            <dt class="col-sm-3">
                Inmueble
            </dt>

            <dd class="col-sm-9">
                @(Model.Inmueble != null
                                ? Model.Inmueble.Direccion
                                : "-")
            </dd>


            <dt class="col-sm-3">
                Monto diario
            </dt>

            <dd class="col-sm-9">
                $@Model.MontoDiario.ToString("N2")
            </dd>


            <dt class="col-sm-3">
                Fecha de inicio
            </dt>

            <dd class="col-sm-9">
                @Model.FechaInicio.ToString("dd/MM/yyyy HH:mm")
            </dd>


            <dt class="col-sm-3">
                Fecha de finalización
            </dt>

            <dd class="col-sm-9">
                @Model.FechaFin.ToString("dd/MM/yyyy HH:mm")
            </dd>


            <dt class="col-sm-3">
                Estado actual
            </dt>

            <dd class="col-sm-9">

                @if (Model.Estado)
                {
                    <span class="badge bg-success">
                        Activa
                    </span>
                }
                else
                {
                    <span class="badge bg-danger">
                        Inactiva
                    </span>
                }

            </dd>

        </dl>

    </div>


    <!-- FORMULARIO DE BAJA -->

    <form asp-action="Delete" method="post">

        @Html.AntiForgeryToken()

        <input type="hidden" asp-for="IdReserva" />


        <div class="mt-4">

            <button type="submit" class="btn btn-danger">

                <i class="bi bi-trash"></i>
                Confirmar Baja

            </button>


            <a asp-action="Index" class="btn btn-secondary">

                <i class="bi bi-arrow-left"></i>
                Cancelar

            </a>

        </div>

    </form>

</div>