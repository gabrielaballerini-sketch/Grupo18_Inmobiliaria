@model IEnumerable<Grupo18_Inmobiliaria.Models.Inmueble>

@{
    ViewData["Title"] = "Listado de Inmuebles";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1>Listado de Inmuebles</h1>

        <a asp-action="Create" class="btn btn-primary">
            Nuevo Inmueble
        </a>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            No hay inmuebles registrados.
        </div>
    }
    else
    {
        <div class="table-responsive">

            <table class="table table-striped table-hover align-middle">

                <thead class="table-dark">
                    <tr>
                        <th>Dirección</th>
                        <th>Capacidad</th>
                        <th>Precio Alquiler</th>
                        <th>Propietario</th>
                        <th>Tipo</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Direccion</td>
                            <td>@item.Capacidad pers.</td>
                            <td>$@item.PrecioAlquiler</td>
                            <td>@(item.Propietario != null ? $"{item.Propietario.Nombre} {item.Propietario.Apellido}" : "Sin Propietario")</td>
                            <td>@(item.TipoInmueble != null ? item.TipoInmueble.Descripcion : "Sin Tipo")</td>

                            <td class="text-center">
                                <a asp-action="Edit"
                                   asp-route-id="@item.IdInmueble"
                                   class="btn btn-warning btn-sm">
                                     <i class="bi bi-pencil-square"></i>
                                </a>

                                <a asp-action="Delete"
                                   asp-route-id="@item.IdInmueble"
                                   class="btn btn-danger btn-sm">
                                      <i class="bi bi-trash"></i>


                                 <a asp-action="Details" asp-route-id="@item.IdInmueble" class="btn btn-info btn-sm text-white">
                                 <i class="bi bi-eye"></i>
                                 </a> 



                                </a>
                            </td>
                        </tr>
                    }
                </tbody>

            </table>

        </div>

        <!-- Botones de Paginación -->
        @if (ViewBag.TotalPaginas > 1)
        {
            <div class="mt-3 text-center">
                @if (ViewBag.PaginaActual > 1)
                {
                    <a asp-action="Index" asp-route-pagina="@(ViewBag.PaginaActual - 1)"
                       class="btn btn-outline-primary me-2">Anterior</a>
                }

                @if (ViewBag.PaginaActual < ViewBag.TotalPaginas)
                {
                    <a asp-action="Index" asp-route-pagina="@(ViewBag.PaginaActual + 1)"
                       class="btn btn-outline-primary">Siguiente</a>
                }
            </div>
        }
    }

    <!-- BOTÓN INACTIVOS ABAJO DEL TODO -->
    <div class="mt-4 mb-3">
        <a asp-action="Inactivos" class="btn btn-secondary">
            <i class="bi bi-archive"></i> Ver Inactivos
        </a>
    </div>

</div>