@model Grupo18_Inmobiliaria.Models.Inmueble

@{
    ViewData["Title"] = "Dar de Baja Inmueble";
}

<div class="container mt-4">

    <div class="card shadow">

        <div class="card-header bg-danger text-white">
            <h3 class="mb-0">Dar de Baja Inmueble</h3>
        </div>

        <div class="card-body">

            <div class="alert alert-warning" role="alert">
                <strong>Atención:</strong>
                estás a punto de dar de baja este inmueble.
                El registro no será eliminado físicamente de la base de datos.
            </div>

            <h5 class="mb-3">Datos del inmueble</h5>

            <dl class="row">

                <dt class="col-sm-3">
                    Dirección
                </dt>
                <dd class="col-sm-9">
                    @Model.Direccion
                </dd>

                <dt class="col-sm-3">
                    Tipo de Inmueble
                </dt>
                <dd class="col-sm-9">
                    @(Model.TipoInmueble != null ? Model.TipoInmueble.Descripcion : "Sin Tipo")
                </dd>

                <dt class="col-sm-3">
                    Propietario
                </dt>
                <dd class="col-sm-9">
                    @(Model.Propietario != null ? $"{Model.Propietario.Nombre} {Model.Propietario.Apellido}" : "Sin Propietario")
                </dd>

                <dt class="col-sm-3">
                    Capacidad
                </dt>
                <dd class="col-sm-9">
                    @Model.Capacidad pers.
                </dd>

                <dt class="col-sm-3">
                    Precio de Alquiler
                </dt>
                <dd class="col-sm-9">
                    $@Model.PrecioAlquiler
                </dd>

            </dl>

            <hr />

            <div class="d-flex gap-2">

                <form asp-action="Delete" method="post">

                    <input type="hidden" asp-for="IdInmueble" />

                    <button type="submit" class="btn btn-danger">
                        Confirmar Baja
                    </button>

                </form>

                <a asp-action="Index" class="btn btn-secondary">
                    Cancelar
                </a>

            </div>

        </div>
    </div>
</div>