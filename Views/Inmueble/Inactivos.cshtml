@model IEnumerable<Grupo18_Inmobiliaria.Models.Inmueble>

@{
    ViewData["Title"] = "Inmuebles Inactivos";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1>Inmuebles Inactivos</h1>

        <a asp-action="Index" class="btn btn-secondary">
            Volver a Inmuebles
        </a>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            No hay inmuebles inactivos registrados.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">

                <thead class="table-dark">
                    <tr>
                        <th>Dirección</th>
                        <th>Capacidad</th>
                        <th>Precio Alquiler</th>
                        <th>Propietario</th>
                        <th>Tipo</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Direccion</td>
                            <td>@item.Capacidad pers.</td>
                            <td>$@item.PrecioAlquiler</td>
                            <td>@(item.Propietario != null ? $"{item.Propietario.Nombre} {item.Propietario.Apellido}" : "Sin Propietario")</td>
                            <td>@(item.TipoInmueble != null ? item.TipoInmueble.Descripcion : "Sin Tipo")</td>

                            <td class="text-center">
                                <form asp-action="Reactivar" asp-route-id="@item.IdInmueble" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-success btn-sm">
                                        Reactivar / Alta
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>

            </table>
        </div>

        <!-- Botones de Paginación -->
        @if (ViewBag.TotalPaginas > 1)
        {
            <div class="mt-3 text-center">
                @if (ViewBag.PaginaActual > 1)
                {
                    <a asp-action="Inactivos" asp-route-pagina="@(ViewBag.PaginaActual - 1)" class="btn btn-outline-primary me-2">Anterior</a>
                }

                @if (ViewBag.PaginaActual < ViewBag.TotalPaginas)
                {
                    <a asp-action="Inactivos" asp-route-pagina="@(ViewBag.PaginaActual + 1)" class="btn btn-outline-primary">Siguiente</a>
                }
            </div>
        }
    }

</div>