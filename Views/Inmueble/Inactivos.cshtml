@model List<Grupo18_Inmobiliaria.Models.Inmueble>

@{
    ViewData["Title"] = "Inmuebles Inactivos";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1>Inmuebles Inactivos</h1>

        <a asp-action="Index" class="btn btn-secondary">
            Volver a Inmuebles
        </a>
    </div>

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Mensaje"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            No hay inmuebles inactivos registrados.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Dirección</th>
                        <th>Tipo</th>
                        <th>Propietario</th>
                        <th>Precio Alquiler</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var inmueble in Model)
                    {
                        <tr>
                            <td>@inmueble.IdInmueble</td>
                            <td>@inmueble.Direccion</td>
                            <td>@(inmueble.TipoInmueble != null ? inmueble.TipoInmueble.Descripcion : "Sin Tipo")</td>
                            <td>@(inmueble.Propietario != null ? $"{inmueble.Propietario.Nombre} {inmueble.Propietario.Apellido}" : "Sin Propietario")</td>
                            <td>$@inmueble.PrecioAlquiler</td>

                            <td class="text-center">
                                <form asp-action="Reactivar" asp-route-id="@inmueble.IdInmueble" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-success btn-sm">
                                        Reactivar / Alta
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Botones de Paginación -->
        <div class="mt-3 text-center">
            @if (ViewBag.PaginaActual > 1)
            {
                <a asp-action="Inactivos" asp-route-pagina="@(ViewBag.PaginaActual - 1)" class="btn btn-outline-primary me-2">Anterior</a>
            }

            @if (ViewBag.PaginaActual < ViewBag.TotalPaginas)
            {
                <a asp-action="Inactivos" asp-route-pagina="@(ViewBag.PaginaActual + 1)" class="btn btn-outline-primary">Siguiente</a>
            }
        </div>
    }

</div>