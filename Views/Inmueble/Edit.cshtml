@model Grupo18_Inmobiliaria.Models.Inmueble

@{
    ViewData["Title"] = "Editar Inmueble";
}

<h2>Editar Inmueble</h2>

<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit">
            <input type="hidden" asp-for="IdInmueble" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group mb-3">
                <label asp-for="Direccion" class="control-label"></label>
                <input asp-for="Direccion" class="form-control" />
                <span asp-validation-for="Direccion" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Capacidad" class="control-label"></label>
                <input asp-for="Capacidad" class="form-control" type="number" />
                <span asp-validation-for="Capacidad" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="IdTipoInmueble" class="control-label">Tipo de Inmueble</label>
                <select asp-for="IdTipoInmueble" class="form-select" asp-items="ViewBag.TiposInmueble">
                    <option value="">-- Seleccionar Tipo --</option>
                </select>
                <span asp-validation-for="IdTipoInmueble" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="PrecioAlquiler" class="control-label">Precio de Alquiler</label>
              <input asp-for="PrecioAlquiler" class="form-control" type="number" step="any" />
                <span asp-validation-for="PrecioAlquiler" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="IdPropietario" class="control-label">Propietario</label>
                <select asp-for="IdPropietario" class="form-select" asp-items="ViewBag.Propietarios">
                    <option value="">-- Seleccionar Propietario --</option>
                </select>
                <span asp-validation-for="IdPropietario" class="text-danger"></span>
            </div>

            <div class="row">
                <div class="col-md-6 form-group mb-3">
                    <label asp-for="Latitud" class="control-label"></label>
                    <input asp-for="Latitud" class="form-control" type="number" step="any" />
                    <span asp-validation-for="Latitud" class="text-danger"></span>
                </div>

                <div class="col-md-6 form-group mb-3">
                    <label asp-for="Longitud" class="control-label"></label>
                    <input asp-for="Longitud" class="form-control" type="number" step="any" />
                    <span asp-validation-for="Longitud" class="text-danger"></span>
                </div>
            </div>

            <div class="form-group form-check mb-3">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="Estado" /> @Html.DisplayNameFor(model => model.Estado)
                </label>
            </div>

            <div class="form-group mt-3">
                <input type="submit" value="Guardar Cambios" class="btn btn-warning" />
                <a asp-action="Index" class="btn btn-secondary">Volver</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}