@{
    ViewData["Title"] = "Inmuebles Disponibles";
}

<style>
    #mapaDisponibles {
        height: 500px;
        width: 100%;
        border-radius: 8px;
    }
    .price-tag {
        background: #0d6efd;
        color: white;
        padding: 4px 8px;
        border-radius: 12px;
        font-weight: bold;
        font-size: 12px;
        box-shadow: 0 2px 5px rgba(0,0,0,0.3);
    }
</style>

<div id="appBuscarDisponibles" class="container mt-3">
    <h2 class="mb-4">Consultar Inmuebles Disponibles</h2>

    <!-- FILTRO DE FECHAS -->
    <div class="card p-3 shadow-sm mb-4">
        <div class="row align-items-end">
            <div class="col-md-4">
                <label class="form-label font-weight-bold">Fecha de Check-in</label>
                <!-- Corregido: v-on:change -->
                <input type="date" class="form-control" v-model="fechaInicio" v-on:change="buscar" />
            </div>
            <div class="col-md-4">
                <label class="form-label font-weight-bold">Fecha de Check-out</label>
                <input type="date" class="form-control" v-model="fechaFin" v-on:change="buscar" />
            </div>
            <div class="col-md-4">
                <button class="btn btn-primary w-100" v-on:click="buscar" :disabled="!fechasValidas">
                    <i class="bi bi-search"></i> Buscar Disponibilidad
                </button>
            </div>
        </div>
    </div>

    <!-- CONTENIDO: MAPA Y LISTA -->
    <div class="row">
        <div class="col-md-7">
            <div id="mapaDisponibles" class="shadow-sm"></div>
        </div>
        
        <div class="col-md-5" style="max-height: 500px; overflow-y: auto;">
            <!-- Alerta de mensaje cuando no hay resultados o se indica un estado -->
            <div v-if="inmuebles.length === 0" class="alert alert-info" v-text="mensaje"></div>

            <!-- Lista de inmuebles -->
            <div v-for="item in inmuebles" :key="item.idInmueble || item.IdInmueble" class="card mb-3 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title" v-text="item.direccion || item.Direccion"></h5>
                    <p class="card-text mb-1">
                        <strong>Capacidad:</strong> <span v-text="item.capacidad || item.Capacidad"></span> personas
                    </p>
                    <p class="card-text mb-2">
                        <strong>Precio por día:</strong> $<span v-text="item.precioAlquiler || item.PrecioAlquiler"></span>
                    </p>
                    
                    <a :href="'/Reserva/Create?idInmueble=' + (item.idInmueble || item.IdInmueble) + '&desde=' + fechaInicio + '&hasta=' + fechaFin" 
                       class="btn btn-outline-success btn-sm w-100">
                        Reservar este Inmueble
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const { createApp } = Vue;

        createApp({
            data() {
                return {
                    fechaInicio: '',
                    fechaFin: '',
                    inmuebles: [],
                    mensaje: 'Seleccione un rango de fechas para consultar.',
                    map: null,
                    markersGroup: null
                }
            },
            computed: {
                fechasValidas() {
                    return this.fechaInicio && this.fechaFin && this.fechaInicio < this.fechaFin;
                }
            },
            mounted() {
                this.map = L.map('mapaDisponibles').setView([-33.2950, -66.3356], 13);
                L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png').addTo(this.map);
                this.markersGroup = L.layerGroup().addTo(this.map);
            },
            methods: {
                async buscar() {
                    if (!this.fechasValidas) return;

                    this.mensaje = 'Cargando...';
                    this.inmuebles = [];
                    this.markersGroup.clearLayers();

                    try {
                        const res = await fetch(`/Inmueble/BuscarDisponibles?fechaInicio=${this.fechaInicio}&fechaFin=${this.fechaFin}`);
                        if (!res.ok) {
                            this.mensaje = `Error del servidor (${res.status})`;
                            return;
                        }
                        this.inmuebles = await res.json();
                        this.mensaje = this.inmuebles.length === 0 ? 'No hay propiedades libres en esas fechas.' : '';
                        this.dibujarPines();
                    } catch (err) {
                        this.mensaje = 'No se pudo conectar con el servidor.';
                        console.error(err);
                    } // Corregido: llave de cierre del catch
                },
                dibujarPines() {
                    const bounds = [];
                    this.inmuebles.forEach(inm => {
                        const lat = inm.latitud || inm.Latitud;
                        const lng = inm.longitud || inm.Longitud;
                        const precio = inm.precioAlquiler || inm.PrecioAlquiler;
                        const dir = inm.direccion || inm.Direccion;

                        if (lat && lng) {
                            const coords = [lat, lng];
                            bounds.push(coords);

                            const icon = L.divIcon({
                                className: 'custom-pin',
                                html: `<div class="price-tag">$${precio}</div>`
                            });

                            L.marker(coords, { icon }).addTo(this.markersGroup)
                             .bindPopup(`<b>${dir}</b><br>$${precio} / día`);
                        }
                    });

                    if (bounds.length > 0) {
                        this.map.fitBounds(bounds, { padding: [30, 30] });
                    }
                }
            }
        }).mount('#appBuscarDisponibles');
    </script>
}