@model Grupo18_Inmobiliaria.Models.Usuario

@{
    ViewData["Title"] = "Mi perfil";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-7">

            <div class="card shadow-sm border-0">

                <!-- ENCABEZADO -->
                <div class="card-header bg-dark text-white text-center py-4">

                    <i class="bi bi-person-circle display-4"></i>

                    <h2 class="mt-2 mb-0">
                        Mi perfil
                    </h2>

                    <p class="mb-0 mt-2">
                        Datos de tu cuenta
                    </p>

                </div>

                <!-- CUERPO -->
                <div class="card-body p-4">

                    <form asp-controller="Usuario" asp-action="Perfil" method="post">

                        @Html.AntiForgeryToken()

                        <!-- MENSAJES DE VALIDACIÓN -->
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3">
                        </div>


                        <!-- NOMBRE DE USUARIO -->
                        <div class="mb-3">

                            <label asp-for="UserName" class="form-label fw-bold">

                                <i class="bi bi-person"></i>
                                Nombre de usuario

                            </label>

                            <input asp-for="UserName" class="form-control" />

                            <span asp-validation-for="UserName" class="text-danger">
                            </span>

                        </div>


                        <!-- ROL -->
                        <div class="mb-3">

                            <label class="form-label fw-bold">

                                <i class="bi bi-shield-check"></i>
                                Rol

                            </label>

                            <input type="text" class="form-control" value="@Model.RolUsuario" readonly />

                        </div>


                        <!-- ESTADO -->
                        <div class="mb-3">

                            <label class="form-label fw-bold">

                                <i class="bi bi-check-circle"></i>
                                Estado

                            </label>

                            <input type="text" class="form-control" value="@(Model.Estado ? "Activo" : "Inactivo")"
                                   readonly />

                        </div>


                        <hr class="my-4" />


                        <!-- CAMBIO DE CONTRASEÑA -->
                        <h5 class="mb-3">

                            <i class="bi bi-lock"></i>
                            Cambiar contraseña

                        </h5>

                        <p class="text-muted">
                            Si no querés cambiar tu contraseña,
                            dejá estos campos vacíos.
                        </p>


                        <!-- CONTRASEÑA ACTUAL -->
                        <div class="mb-3">

                            <label asp-for="PasswordActual" class="form-label fw-bold">

                                Contraseña actual

                            </label>

                            <input asp-for="PasswordActual" type="password" class="form-control"
                                   placeholder="Ingresá tu contraseña actual" />

                            <span asp-validation-for="PasswordActual" class="text-danger">
                            </span>

                        </div>


                        <!-- NUEVA CONTRASEÑA -->
                        <div class="mb-3">

                            <label asp-for="NuevaPassword" class="form-label fw-bold">

                                Nueva contraseña

                            </label>

                            <input asp-for="NuevaPassword" type="password" class="form-control"
                                   placeholder="Ingresá la nueva contraseña" />

                            <span asp-validation-for="NuevaPassword" class="text-danger">
                            </span>

                        </div>


                        <!-- CONFIRMAR CONTRASEÑA -->
                        <div class="mb-3">

                            <label asp-for="ConfirmarPassword" class="form-label fw-bold">

                                Confirmar nueva contraseña

                            </label>

                            <input asp-for="ConfirmarPassword" type="password" class="form-control"
                                   placeholder="Repetí la nueva contraseña" />

                            <span asp-validation-for="ConfirmarPassword" class="text-danger">
                            </span>

                        </div>


                        <hr class="my-4" />


                        <!-- BOTONES -->
                        <div class="d-flex justify-content-between">

                            <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">

                                <i class="bi bi-arrow-left"></i>
                                Volver

                            </a>

                            <button type="submit" class="btn btn-primary">

                                <i class="bi bi-save"></i>
                                Guardar cambios

                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}