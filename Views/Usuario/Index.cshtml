@model IList<Grupo18_Inmobiliaria.Models.Usuario>

@{
    ViewData["Title"] = "Usuarios";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1>
            <i class="bi bi-person-badge me-2"></i>
            Usuarios
        </h1>
        <p class="text-muted mb-0">
            Administración de usuarios del sistema
        </p>
    </div>

    <div>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle me-1"></i>
            Nuevo usuario
        </a>

        <a asp-action="Inactivos" class="btn btn-outline-secondary ms-2">
            <i class="bi bi-person-x me-1"></i>
            Usuarios inactivos
        </a>
    </div>
</div>

@if (Model == null || Model.Count == 0)
{
    <div class="alert alert-info">
        <i class="bi bi-info-circle me-2"></i>
        No hay usuarios activos registrados.
    </div>
}
else
{
    <div class="card shadow-sm">
        <div class="card-body p-0">

            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">
                        <tr>
                            <th>ID</th>
                            <th>Avatar</th>
                            <th>Usuario</th>
                            <th>Rol</th>
                            <th>Estado</th>
                            <th class="text-center">Acciones</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var usuario in Model)
                        {
                            <tr>
                                <td>
                                    @usuario.IdUsuario
                                </td>

                                <td>
                                    @if (!string.IsNullOrEmpty(usuario.Avatar))
                                    {
                                        <img src="@usuario.Avatar"
                                             alt="@usuario.UserName"
                                             class="rounded-circle"
                                             width="32"
                                             height="32"
                                             style="object-fit: cover;" />
                                    }
                                    else
                                    {
                                        <i class="bi bi-person-circle fs-4 text-secondary"></i>
                                    }
                                </td>

                                <td>
                                    @usuario.UserName
                                </td>

                                <td>
                                    @if (usuario.RolUsuario.ToString() == "Administrativo")
                                    {
                                        <span class="badge bg-primary">
                                            <i class="bi bi-shield-check me-1"></i>
                                            Administrativo
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            <i class="bi bi-person me-1"></i>
                                            Empleado
                                        </span>
                                    }
                                </td>

                                <td>
                                    <span class="badge bg-success">
                                        <i class="bi bi-check-circle me-1"></i>
                                        Activo
                                    </span>
                                </td>

                                <td class="text-center">

                                    <a asp-action="Edit"
                                       asp-route-id="@usuario.IdUsuario"
                                       class="btn btn-sm btn-outline-primary me-1"
                                       title="Editar">
                                        <i class="bi bi-pencil"></i>
                                    </a>

                                    <a asp-action="Baja"
                                       asp-route-id="@usuario.IdUsuario"
                                       class="btn btn-sm btn-outline-danger"
                                       title="Dar de baja">
                                        <i class="bi bi-person-x"></i>
                                    </a>

                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>

        </div>
    </div>

    @if (ViewBag.TotalPaginas > 1)
    {
        <nav class="mt-4">
            <ul class="pagination justify-content-center">

                @for (int i = 1; i <= ViewBag.TotalPaginas; i++)
                {
                    <li class="page-item @(i == ViewBag.Pagina ? "active" : "")">
                        <a class="page-link"
                           asp-action="Index"
                           asp-route-pagina="@i"
                           asp-route-tamPagina="@ViewBag.TamPagina">
                            @i
                        </a>
                    </li>
                }

            </ul>
        </nav>
    }
}