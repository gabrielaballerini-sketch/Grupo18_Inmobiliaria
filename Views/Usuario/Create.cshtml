@model Grupo18_Inmobiliaria.Models.Usuario

@{
    ViewData["Title"] = "Nuevo usuario";
}

<div class="row justify-content-center">

    <div class="col-md-7 col-lg-6">

        <div class="card shadow-sm">

            <div class="card-header bg-primary text-white">
                <h4 class="mb-0">
                    <i class="bi bi-person-plus me-2"></i>
                    Nuevo usuario
                </h4>
            </div>

            <div class="card-body p-4">

                <form asp-action="Create" method="post">

                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3">
                    </div>

                    <div class="mb-3">

                        <label asp-for="UserName" class="form-label">
                            Usuario
                        </label>

                        <div class="input-group">
                            <span class="input-group-text">
                                <i class="bi bi-person"></i>
                            </span>

                            <input asp-for="UserName"
                                   class="form-control"
                                   placeholder="Ingrese el nombre de usuario" />
                        </div>

                        <span asp-validation-for="UserName"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="mb-3">

                        <label asp-for="Password" class="form-label">
                            Contraseña
                        </label>

                        <div class="input-group">
                            <span class="input-group-text">
                                <i class="bi bi-lock"></i>
                            </span>

                            <input asp-for="Password"
                                   type="password"
                                   class="form-control"
                                   placeholder="Ingrese la contraseña" />
                        </div>

                        <span asp-validation-for="Password"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="mb-4">

                        <label asp-for="RolUsuario" class="form-label">
                            Rol
                        </label>

                        <div class="input-group">
                            <span class="input-group-text">
                                <i class="bi bi-shield"></i>
                            </span>

                            <select asp-for="RolUsuario"
                                    class="form-select"
                                    asp-items="Html.GetEnumSelectList<Grupo18_Inmobiliaria.Models.RolUsuario>()">
                            </select>
                        </div>

                        <span asp-validation-for="RolUsuario"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="d-flex justify-content-between">

                        <a asp-action="Index"
                           class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left me-1"></i>
                            Volver
                        </a>

                        <button type="submit"
                                class="btn btn-primary">
                            <i class="bi bi-check-circle me-1"></i>
                            Crear usuario
                        </button>

                    </div>

                </form>

            </div>
        </div>

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}