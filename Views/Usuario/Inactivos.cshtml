@model IList<Grupo18_Inmobiliaria.Models.Usuario>

@{
    ViewData["Title"] = "Usuarios inactivos";
}

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>
        <h1>
            <i class="bi bi-person-x me-2"></i>
            Usuarios inactivos
        </h1>

        <p class="text-muted mb-0">
            Usuarios dados de baja del sistema
        </p>
    </div>

    <a asp-action="Index"
       class="btn btn-outline-primary">
        <i class="bi bi-person-check me-1"></i>
        Usuarios activos
    </a>

</div>

@if (Model == null || Model.Count == 0)
{
    <div class="alert alert-info">
        <i class="bi bi-info-circle me-2"></i>
        No hay usuarios inactivos.
    </div>
}
else
{
    <div class="card shadow-sm">

        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">

                        <tr>
                            <th>ID</th>
                            <th>Avatar</th>
                            <th>Usuario</th>
                            <th>Rol</th>
                            <th>Estado</th>
                            <th class="text-center">Acciones</th>
                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var usuario in Model)
                        {
                            <tr>

                                <td>
                                    @usuario.IdUsuario
                                </td>

                                <td>
                                    @if (!string.IsNullOrEmpty(usuario.Avatar))
                                    {
                                        <img src="@usuario.Avatar"
                                             alt="@usuario.UserName"
                                             class="rounded-circle"
                                             width="32"
                                             height="32"
                                             style="object-fit: cover;" />
                                    }
                                    else
                                    {
                                        <i class="bi bi-person-circle fs-4 text-secondary"></i>
                                    }
                                </td>

                                <td>
                                    @usuario.UserName
                                </td>

                                <td>
                                    @usuario.RolUsuario
                                </td>

                                <td>
                                    <span class="badge bg-danger">
                                        <i class="bi bi-x-circle me-1"></i>
                                        Inactivo
                                    </span>
                                </td>

                                <td class="text-center">

                                    <form asp-action="Reactivar"
                                          method="post"
                                          class="d-inline">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="id"
                                               value="@usuario.IdUsuario" />

                                        <button type="submit"
                                                class="btn btn-sm btn-outline-success"
                                                title="Reactivar usuario">

                                            <i class="bi bi-person-check me-1"></i>
                                            Reactivar

                                        </button>

                                    </form>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

    @if (ViewBag.TotalPaginas > 1)
    {
        <nav class="mt-4">

            <ul class="pagination justify-content-center">

                @for (int i = 1; i <= ViewBag.TotalPaginas; i++)
                {
                    <li class="page-item @(i == ViewBag.Pagina ? "active" : "")">

                        <a class="page-link"
                           asp-action="Inactivos"
                           asp-route-pagina="@i"
                           asp-route-tamPagina="@ViewBag.TamPagina">
                            @i
                        </a>

                    </li>
                }

            </ul>

        </nav>
    }
}