@model Grupo18_Inmobiliaria.Models.TipoInmueble

@{
    ViewData["Title"] = "Editar Tipo de Inmueble";
}

<h2>Editar Tipo de Inmueble</h2>
<hr />

<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <input type="hidden" asp-for="IdTipoInmueble" />

            <div class="form-group mb-3">
                <label asp-for="Descripcion" class="control-label fw-bold">Descripción</label>
                <input asp-for="Descripcion" class="form-control" />
                <span asp-validation-for="Descripcion" class="text-danger"></span>
            </div>

            <div class="form-group mt-3">
                <button type="submit" class="btn btn-primary">Actualizar</button>
                <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}