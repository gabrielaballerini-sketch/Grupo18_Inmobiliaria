@model IEnumerable<Grupo18_Inmobiliaria.Models.TipoInmueble>

@{
    ViewData["Title"] = "Tipos de Inmuebles";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Tipos de Inmuebles</h1>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> Nuevo Tipo
    </a>
</div>


<table class="table table-striped table-hover mt-3">
    <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>Descripción</th>
            <th>Estado</th>
            <th class="text-center">Acciones</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var item in Model) {
        <tr>
            <td>@item.IdTipoInmueble</td>
            <td>@item.Descripcion</td>
            <td>
                @if (item.Estado)
                {
                    <span class="badge bg-success">Activo</span>
                }
                else
                {
                    <span class="badge bg-danger">Inactivo</span>
                }
            </td>
            <td class="text-center">
                <a asp-action="Edit" asp-route-id="@item.IdTipoInmueble" class="btn btn-sm btn-warning me-1">
                    <i class="bi bi-pencil"></i> Editar
                </a>
                <a asp-action="Delete" asp-route-id="@item.IdTipoInmueble" class="btn btn-sm btn-danger">
                    <i class="bi bi-trash"></i> Eliminar
                </a>
            </td>
        </tr>
    }
    </tbody>
</table>