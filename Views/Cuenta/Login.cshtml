@{
ViewData["Title"] = "Iniciar sesión";
}



<div class="login-page">


<div class="login-container">

    <div class="card login-card">

        <div class="row g-0">

            <!-- LADO IZQUIERDO -->
            <div class="col-md-6">

                <div class="login-info">

                    <div class="logo">
                        <i class="bi bi-buildings"></i>
                    </div>

                    <h1>Grupo18</h1>

                    <h4>Inmobiliaria</h4>

                    <p class="mt-3">
                        Sistema integral para la gestión
                        de propiedades, inquilinos,
                        propietarios y reservas.
                    </p>

                    <div class="login-features">

                        <div class="login-feature">
                            <i class="bi bi-house-door"></i>
                            <span>Gestión de inmuebles</span>
                        </div>

                        <div class="login-feature">
                            <i class="bi bi-people"></i>
                            <span>Gestión de inquilinos</span>
                        </div>

                        <div class="login-feature">
                            <i class="bi bi-calendar-check"></i>
                            <span>Gestión de reservas</span>
                        </div>

                        <div class="login-feature">
                            <i class="bi bi-person-badge"></i>
                            <span>Administración de usuarios</span>
                        </div>

                    </div>

                </div>

            </div>

            <!-- LADO DERECHO -->
            <div class="col-md-6">

                <div class="login-form">

                    <div>
                        <h2>Iniciar sesión</h2>

                        <p class="subtitle">
                            Ingresá tus credenciales para continuar.
                        </p>
                    </div>

                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger" role="alert">
                            <i class="bi bi-exclamation-triangle me-2"></i>
                            @ViewBag.Error
                        </div>
                    }

                    <form asp-controller="Cuenta"
                          asp-action="Login"
                          method="post">

                        @Html.AntiForgeryToken()

                        <div class="mb-4">

                            <label for="userName" class="form-label">
                                Usuario
                            </label>

                            <div class="input-group">

                                <span class="input-group-text">
                                    <i class="bi bi-person"></i>
                                </span>

                                <input type="text"
                                       id="userName"
                                       name="userName"
                                       class="form-control login-input"
                                       placeholder="Ingresá tu usuario"
                                       autocomplete="username"
                                       required />

                            </div>

                        </div>

                        <div class="mb-4">

                            <label for="password" class="form-label">
                                Contraseña
                            </label>

                            <div class="input-group">

                                <span class="input-group-text">
                                    <i class="bi bi-lock"></i>
                                </span>

                                <input type="password"
                                       id="password"
                                       name="password"
                                       class="form-control login-input"
                                       placeholder="Ingresá tu contraseña"
                                       autocomplete="current-password"
                                       required />

                            </div>

                        </div>

                        <div class="d-grid">

                            <button type="submit"
                                    class="btn btn-primary login-button">

                                <i class="bi bi-box-arrow-in-right me-2"></i>
                                Iniciar sesión

                            </button>

                        </div>

                    </form>

                    <div class="login-footer">
                        <i class="bi bi-shield-lock me-1"></i>
                        Acceso seguro al sistema
                    </div>

                </div>

            </div>

        </div>

    </div>

</div>


</div>
<style>
    .login-page {
        min-height: 75vh;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .login-container {
        max-width: 950px;
        width: 100%;
    }

    .login-card {
        border: none;
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 10px 35px rgba(0, 0, 0, 0.12);
    }

    .login-info {
        background: linear-gradient(135deg, #0d6efd, #084298);
        color: white;
        padding: 50px 40px;
        min-height: 520px;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    .login-info .logo {
        font-size: 4rem;
        margin-bottom: 20px;
    }

    .login-info h1 {
        font-weight: 700;
        margin-bottom: 15px;
    }

    .login-info p {
        opacity: 0.9;
        font-size: 1.05rem;
    }

    .login-features {
        margin-top: 30px;
    }

    .login-feature {
        display: flex;
        align-items: center;
        margin-bottom: 15px;
    }

    .login-feature i {
        font-size: 1.3rem;
        width: 35px;
    }

    .login-form {
        padding: 50px 45px;
        background-color: white;
        min-height: 520px;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    .login-form h2 {
        font-weight: 700;
        margin-bottom: 8px;
    }

    .login-form .subtitle {
        color: #6c757d;
        margin-bottom: 30px;
    }

    .form-label {
        font-weight: 600;
    }

    .input-group-text {
        background-color: #f8f9fa;
        border-right: none;
    }

    .login-input {
        border-left: none;
        padding: 12px;
    }

    .login-input:focus {
        box-shadow: none;
        border-color: #ced4da;
    }

    .input-group:focus-within {
        box-shadow: 0 0 0 0.2rem rgba(13, 110, 253, 0.15);
        border-radius: 6px;
    }

    .login-button {
        padding: 12px;
        font-weight: 600;
        border-radius: 8px;
        margin-top: 10px;
    }

    .login-footer {
        text-align: center;
        color: #6c757d;
        font-size: 0.9rem;
        margin-top: 25px;
    }

    @@media (max-width: 767px) {
        .login-page {
            min-height: auto;
            padding: 30px 10px;
        }

        .login-info {
            min-height: auto;
            padding: 35px 30px;
            text-align: center;
        }

        .login-info .logo {
            font-size: 3rem;
        }

        .login-features {
            display: none;
        }

        .login-form {
            min-height: auto;
            padding: 35px 30px;
        }
    }
</style>
